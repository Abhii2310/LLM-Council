# Backend environment variables
# Copy to .env and fill values

GROQ_API_KEY=
OPENROUTER_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
OLLAMA_API_KEY=
DEEPSEEK_API_KEY=
COHERE_API_KEY=
CEREBRAS_API_KEY=
SAMBANOVA_API_KEY=
CLOUDFLARE_API_KEY=
CLOUDFLARE_ACCOUNT_ID=
NVIDIA_API_KEY=
TOGETHER_API_KEY=
AIMLAPI_API_KEY=
TAVILY_API_KEY=
JINA_API_KEY=
SERPAPI_API_KEY=

# Optional
BACKEND_CORS_ORIGINS=http://localhost:5173
REQUEST_TIMEOUT_SECONDS=45
SQLITE_DB_PATH=data/llm_council.sqlite3
CHATGPT_ENABLED=true
CHATGPT_MODEL=openai/gpt-4o-mini
PREFER_LOCAL_OLLAMA=false
OLLAMA_PRIMARY_MODEL=ollama/llama3.1:8b
OLLAMA_FALLBACK_MODEL=ollama/qwen2.5:7b
WEB_RESEARCH_ENABLED=true
WEB_RESEARCH_TIMEOUT_SECONDS=10

# Local Phase-1 RAG (dependency-free)
RAG_ENABLED=true
RAG_DOCS_PATH=knowledge_base
RAG_CHUNK_SIZE=900
RAG_CHUNK_OVERLAP=150
RAG_TOP_K=4
